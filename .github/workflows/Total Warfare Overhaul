name: Build Total Warfare DLL
name: Build Total Warfare DLL

on:
  workflow_dispatch:
  push:
    paths:
      - 'mods/total_warfare.c'
      - 'mods/mercenaries_mod.h'
      - 'mods/mercfx.h'
      - '.github/workflows/build.yml'

jobs:
  build-windows-x64:
    runs-on: windows-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up MSVC
        uses: ilammy/msvc-dev-cmd@v1
        with:
          arch: x64

      - name: Build DLL
        shell: cmd
        working-directory: mods
        run: |
          cl /nologo /W4 /O2 /LD /I . total_warfare.c /Fe:total_warfare.dll /link /MACHINE:X64

      - name: Upload DLL artifact
        uses: actions/upload-artifact@v4
        with:
          name: total_warfare-dll
          path: mods/total_warfare.dll
          if-no-files-found: error

